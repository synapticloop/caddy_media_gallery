    }
    // Per user request 2026-06-30: capture the server's
    // original header text (e.g. "Media (89 - search 'st'
    // - showing 30 of 33)") on page load. When the visitor
    // types more chars (JS takes over) and then types back
    // to match the URL ?q=, the JS restores this text.
    //
    // The text is stored in the data-search-header-current
    // hidden span (set on page load by the server template).
    var originalServerText = '';
    var currentEl = document.querySelector('[data-search-header-current]');
    if (currentEl) {
