       (window.scrollTo with behavior: 'smooth') -->
<a href="#top" class="back-to-top" id="back-to-top" aria-label="{{t "back_to_top_aria"}}">
  <span class="back-to-top-text">{{t "back_to_top"}}</span>
  <span class="back-to-top-pct" aria-hidden="true">0%</span>
</a>
<script>

/* Per user feedback 2026-07-01: shimmer animation while
   thumbnails are loading.

   BEHAVIOR:
   - The Go-side render does NOT pre-add the .loading class
     (see buildCardHTML in render.go). The reason: pre-adding
     it makes browser-cached thumbs briefly flash the shimmer
     on a reload (the cached image would already be loaded
     before JS runs, but the per-card class would force a
     re-shimmer).
   - This JS adds .loading only to thumbs whose <img> is NOT
     already complete (i.e., the browser hasn't loaded it
     yet). For cached thumbs with img.complete=true, the
     class is never added — no shimmer flash on reload.
   - For below-the-fold lazy-loaded images, img.complete is
     false (the browser hasn't started loading yet). The
     shimmer stays applied until the user scrolls down and
     the lazy-load triggers. This is intentional — the
     shimmer appears only for thumbs the user is about to
     see, not for hidden ones.
   - When the <img> fires load or error, we remove the
     .loading class. Either way the placeholder isn't needed.
   - The CSS (.thumb.loading::before with the thumb-shimmer
     keyframes) handles the visual animation, with a
     prefers-reduced-motion override that disables it. */
(function() {
  var thumbs = document.querySelectorAll('.thumb img');
  for (var i = 0; i < thumbs.length; i++) {
    (function(img) {
      var thumb = img.closest('.thumb');
      if (!thumb) return;
