    // collapsible. The header (just "EXIF" text) is
    // always visible when the panel is shown. Clicking
    // it toggles between expanded (showing all rows)
    // and collapsed (just the header). The collapsed/
    // expanded state is stored in localStorage so the
    // user doesn't have to re-pick on every visit.
    '<div class="lb-exif" hidden>' +
      '<div class="lb-exif-header" data-lb-panel="exif" role="button" tabindex="0" aria-expanded="true" title="Click to collapse/expand">{{t "exif_label"}}</div>' +
      '<div class="lb-exif-body">' +
        '<table class="lb-exif-table">' +
          '<tr><td class="lb-exif-label">' + t('exif_camera') + '</td><td class="lb-exif-val" data-exif="camera"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('exif_lens') + '</td><td class="lb-exif-val" data-exif="lens"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('exif_date') + '</td><td class="lb-exif-val" data-exif="date"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('exif_exposure') + '</td><td class="lb-exif-val" data-exif="exposure"></td></tr>' +
        '</table>' +
      '</div>' +
    '</div>' +
    // Per user request 2026-07-02: video metadata panel
    // (parallel to the EXIF panel for images). Shows
    // duration, container, codecs, bitrate, framerate
    // extracted from ffprobe (cached in .vmeta sidecars).
    // Per user request 2026-07-02: parallel structure
    // to the EXIF panel — collapsible header + body.
    // Same localStorage pattern (gallery-lb-video-meta-collapsed).
    '<div class="lb-video-meta" hidden>' +
      '<div class="lb-exif-header" data-lb-panel="video-meta" role="button" tabindex="0" aria-expanded="true" title="Click to collapse/expand">{{t "meta_label"}}</div>' +
      '<div class="lb-exif-body">' +
        '<table class="lb-exif-table">' +
          '<tr><td class="lb-exif-label">' + t('meta_duration') + '</td><td class="lb-exif-val" data-video="duration"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('meta_container') + '</td><td class="lb-exif-val" data-video="container"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('meta_video') + '</td><td class="lb-exif-val" data-video="video-codec"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('meta_audio') + '</td><td class="lb-exif-val" data-video="audio-codec"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('meta_bitrate') + '</td><td class="lb-exif-val" data-video="bitrate"></td></tr>' +
          '<tr><td class="lb-exif-label">' + t('meta_framerate') + '</td><td class="lb-exif-val" data-video="framerate"></td></tr>' +
        '</table>' +
      '</div>' +
    '</div>';
  document.body.appendChild(overlay);

  var media = overlay.appendChild(document.createElement('div'));
  media.style.cssText = 'display:flex;align-items:center;justify-content:center;';
  var currentEl = null;
  var counter = overlay.querySelector('.lb-counter');
  var caption = overlay.querySelector('.lb-caption');

  // Media cards: image cards have an <img> child; video cards
  // have the .video class (with a <div class="thumb-video">
  // child instead of an <img>). Both open in the unified
  // lightbox. Other file types (no <img> and not .video) keep
  // their default link behavior.
  var cards = Array.prototype.slice.call(
    document.querySelectorAll('.card')
  ).filter(function(c) {
    return c.querySelector('img') || c.classList.contains('video');
  });
  var idx = 0;

  // Per user request 2026-07-02: the EXIF and META
  // panels are collapsible. Clicking the panel header
  // ("EXIF" or "META" text) toggles between expanded
  // (showing all rows) and collapsed (showing just the
  // header). The state is persisted in localStorage so
  // the user doesn't have to re-pick on every visit.
  //
  // Keys: gallery-lb-exif-collapsed and
  // gallery-lb-video-meta-collapsed. Value: 'true' if
  // collapsed (the key is removed when expanded).
  function setupPanelToggle(panelSelector, storageKey) {
    var panel = overlay.querySelector(panelSelector);
    if (!panel) return;
    var header = panel.querySelector('.lb-exif-header');
    if (!header) return;
    // Apply the persisted state on first render.
    var isCollapsed = false;
    try {
      isCollapsed = localStorage.getItem(storageKey) === 'true';
    } catch (e) { /* localStorage unavailable */ }
    if (isCollapsed) {
      panel.classList.add('collapsed');
      header.setAttribute('aria-expanded', 'false');
    }
    // Click toggles and persists. Per user request
    // 2026-07-02: when collapsing, we re-position the
    // panel so it sits to the left of the image (the
    // show() function positions the panel when it's
    // first opened, but the user may have toggled the
    // panel after that — in which case we need to
    // re-measure and re-position).
    function positionPanel() {
      if (typeof positionCollapsedPanel === 'function') {
        positionCollapsedPanel();
      }
    }
    function toggle() {
      var nowCollapsed = panel.classList.toggle('collapsed');
      header.setAttribute('aria-expanded', nowCollapsed ? 'false' : 'true');
      try {
        if (nowCollapsed) {
          localStorage.setItem(storageKey, 'true');
        } else {
          localStorage.removeItem(storageKey);
        }
      } catch (e) { /* localStorage unavailable */ }
      // Re-position the panel after toggling. Same
      // image-ready approach as in show() — wait for
      // the image's decode() promise to resolve before
      // measuring, so we don't catch a half-laid-out
      // image with width=0.
      if (nowCollapsed) {
        // Same approach as in show() — position
        // immediately using the current bounding rect
        // (poster-sized for videos), then re-position
        // on loadedmetadata when the actual video
        // dimensions are known.
        if (currentEl && currentEl.tagName === 'IMG' && typeof currentEl.decode === 'function') {
          currentEl.decode().catch(function() {}).then(function() {
            requestAnimationFrame(positionPanel);
          });
        } else if (currentEl && currentEl.tagName === 'VIDEO') {
          requestAnimationFrame(positionPanel);
          currentEl.addEventListener('loadedmetadata', function() {
            requestAnimationFrame(positionPanel);
          }, { once: true });
        } else {
          requestAnimationFrame(positionPanel);
        }
      } else {
        // Per user feedback 2026-07-02: when expanding,
        // clear the inline top/left/transform styles
        // so the expanded CSS (bottom: 6rem, left: 50%,
        // transform: translateX(-50%)) takes effect
        // cleanly. Without this, the inline top from the
        // previous collapse persists, which combined
        // with the CSS bottom forces the panel to a
        // weird tall height (viewport.height - top -
        // bottom).
        panel.style.left = '';
        panel.style.top = '';
        panel.style.transform = '';
      }
    }
    header.addEventListener('click', toggle);
    // Keyboard support: Enter / Space toggles (for the
    // role="button" + tabindex="0" pattern).
    header.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });
  }
  setupPanelToggle('.lb-exif', 'gallery-lb-exif-collapsed');
  setupPanelToggle('.lb-video-meta', 'gallery-lb-video-meta-collapsed');

  function clear() {
    // Pause the current element if it's a video (removing the
    // element from the DOM also stops playback, but explicit
    // pause is cleaner and matches the close-on-cleanup intent).
    if (currentEl) {
      if (typeof currentEl.pause === 'function') currentEl.pause();
      currentEl.remove();
      currentEl = null;
    }
  }

  function show(i) {
    if (cards.length === 0) return;
    idx = ((i % cards.length) + cards.length) % cards.length;
    var c = cards[idx];
    var href = c.getAttribute('href') || '';
    var name = (c.querySelector('.tile-name') || {}).textContent || '';
    var isVideo = c.classList.contains('video');
    clear();
    if (isVideo) {
      // Per user request 2026-06-19: show the video thumbnail
      // (extracted from the first frame by ffmpeg, served as a
      // WebP by the server) as the <video poster>. The browser
      // shows the poster image until the user clicks play, then
      // swaps to the first video frame and starts playback.
      //
      // The poster URL is the same as the <img class="thumb-img">
      // src that Phase 62 added to the tile card. We extract it
      // from the DOM rather than duplicating it in a data-*
      // attribute.
      var thumbImg = c.querySelector('img.thumb-img');
      var thumbSrc = thumbImg ? thumbImg.getAttribute('src') : '';
      var v = document.createElement('video');
      v.src = href;
      v.controls = true;
      v.preload = 'metadata';
      v.playsInline = true;
      v.alt = name;
      // Only set poster if a thumbnail URL is available. If ffmpeg
      // is missing or no_video_thumbs is set, the <img> won't be
      // in the card and we just skip poster (browser shows black
      // frame, same as before Phase 62).
      if (thumbSrc) v.poster = thumbSrc;
      currentEl = v;
      // Per user request 2026-07-02: hide the video
      // metadata panel while the video is playing, show
      // it again when paused. The user wants the panel
      // to not distract from the video content during
      // playback.
      //
      // We track the "default" visibility (set by the
      // panel population code above) using a data
      // attribute on the panel. play hides the panel,
      // pause restores the default.
      v.addEventListener('play', function() {
        videoMetaPanel.hidden = true;
      });
      v.addEventListener('pause', function() {
        // Restore the default visibility (set by the
        // population code earlier in this function).
        // If the panel was hidden because the video has
        // no metadata, it stays hidden.
        var defaultHidden = videoMetaPanel.getAttribute('data-default-hidden') === 'true';
        videoMetaPanel.hidden = defaultHidden;
      });
      v.addEventListener('ended', function() {
        // Same as pause: the video has stopped playing.
        var defaultHidden = videoMetaPanel.getAttribute('data-default-hidden') === 'true';
        videoMetaPanel.hidden = defaultHidden;
      });
    } else {
      var img = document.createElement('img');
      img.src = href;
      img.alt = name;
      currentEl = img;
    }
    media.appendChild(currentEl);
    counter.textContent = (idx + 1) + ' / ' + cards.length;
    caption.textContent = name;
    // Per user request 2026-06-29: EXIF is read EAGERLY at
    // scan time and written to a .exif sidecar. The card
    // template renders the EXIF data inline as data-exif-*
    // attributes (so the lightbox has the data without a
    // server round-trip). The "EXIF" pill is also shown on
    // the card overlay (nice UX feature, brings back the
    // pill that the lazy version removed).
    //
    // The lightbox just reads the attributes off the card
    // — synchronous, no fetch, no JSON parsing. The panel
    // shows immediately when the lightbox opens. If the
    // file has no EXIF (or the operator set no_exif), the
    // data-exif-* attributes are absent and the panel is
    // hidden.
    var exifPanel = overlay.querySelector('.lb-exif');
    var videoMetaPanel = overlay.querySelector('.lb-video-meta');
    if (isVideo) {
      // Per user request 2026-07-02: populate the video
      // metadata panel for video files. Reads the
      // data-video-* attributes that buildVideoMetaAttrString
      // rendered onto the card. The panel is hidden if no
      // attributes are present (no ffprobe data cached).
      var duration = c.getAttribute('data-video-duration') || '';
      var container = c.getAttribute('data-video-container') || '';
      var videoCodec = c.getAttribute('data-video-video-codec') || '';
      var audioCodec = c.getAttribute('data-video-audio-codec') || '';
      var bitrate = c.getAttribute('data-video-bitrate') || '';
      var framerate = c.getAttribute('data-video-framerate') || '';
      if (duration || container || videoCodec || audioCodec || bitrate || framerate) {
        videoMetaPanel.querySelector('[data-video="duration"]').textContent = duration || '\u2014';
        videoMetaPanel.querySelector('[data-video="container"]').textContent = container || '\u2014';
        videoMetaPanel.querySelector('[data-video="video-codec"]').textContent = videoCodec || '\u2014';
        videoMetaPanel.querySelector('[data-video="audio-codec"]').textContent = audioCodec || '\u2014';
        videoMetaPanel.querySelector('[data-video="bitrate"]').textContent = bitrate || '\u2014';
        videoMetaPanel.querySelector('[data-video="framerate"]').textContent = framerate || '\u2014';
        // Per user request 2026-07-02: track the default
        // visibility so the play/pause handlers can
        // restore it. The panel was hidden here because
        // the video has no metadata (data-default-hidden).
        videoMetaPanel.hidden = false;
        videoMetaPanel.setAttribute('data-default-hidden', 'false');
      } else {
        videoMetaPanel.hidden = true;
        videoMetaPanel.setAttribute('data-default-hidden', 'true');
      }
    } else {
      videoMetaPanel.hidden = true;
      videoMetaPanel.setAttribute('data-default-hidden', 'true');
    }
    if (!isVideo) {
      var cameraMake = c.getAttribute('data-exif-camera-make') || '';
      var cameraModel = c.getAttribute('data-exif-camera-model') || '';
      var lens = c.getAttribute('data-exif-lens') || '';
      var dateTaken = c.getAttribute('data-exif-date') || '';
      var shutter = c.getAttribute('data-exif-shutter') || '';
      var aperture = c.getAttribute('data-exif-aperture') || '';
      var iso = c.getAttribute('data-exif-iso') || '';
      var focal = c.getAttribute('data-exif-focal') || '';
      if (cameraMake || cameraModel || lens || dateTaken || shutter || aperture || iso || focal) {
        // Camera = "Make Model" (or just Make, or just Model)
        var camera = (cameraMake + (cameraMake && cameraModel ? ' ' : '') + cameraModel).trim();
        // Exposure = "Shutter · Aperture · ISO · Focal"
        var exposureParts = [shutter, aperture, iso, focal].filter(function(s) { return s; });
        var exposure = exposureParts.join(' · ');
        exifPanel.querySelector('[data-exif="camera"]').textContent = camera || '—';
        exifPanel.querySelector('[data-exif="lens"]').textContent = lens || '—';
        exifPanel.querySelector('[data-exif="date"]').textContent = dateTaken || '—';
        exifPanel.querySelector('[data-exif="exposure"]').textContent = exposure || '—';
        exifPanel.hidden = false;
      } else {
        exifPanel.hidden = true;
      }
    } else {
      exifPanel.hidden = true;
    }
    overlay.classList.add('open');
    // Per user request 2026-07-02: when the panel is
    // collapsed, position it to the right of the image,
    // slightly overlapping.
    //
    // For images: wait for decode() before measuring
    // (prevents width=0 race condition).
    //
    // For videos: per user report 2026-07-02, the
    // previous approach of waiting for loadedmetadata
    // had two problems:
    //   1. Until loadedmetadata fires, the panel sat at
    //      the CSS fallback position (left: 0.5rem —
    //      "left hand side of the lightbox"), which
    //      looked broken to the user.
    //   2. If loadedmetadata never fires (broken video,
    //      no network), the panel stayed broken for
    //      3 seconds (the fallback timeout).
    //
    // The new approach: position IMMEDIATELY using the
    // current bounding rect (which is the POSTER size
    // for videos — small but at least positioned). Then
    // listen for loadedmetadata and re-position when
    // the actual video dimensions become known. If
    // loadedmetadata never fires (3s timeout), the
    // initial poster-sized position remains.
    if (typeof positionCollapsedPanel === 'function') {
      if (currentEl && currentEl.tagName === 'IMG' && typeof currentEl.decode === 'function') {
        currentEl.decode().catch(function() {}).then(function() {
          requestAnimationFrame(positionCollapsedPanel);
        });
      } else if (currentEl && currentEl.tagName === 'VIDEO') {
        // Position immediately using the current
        // (poster-sized) bounding rect, so the panel
        // is at least on the right side of the lightbox
        // instead of the CSS fallback (left side).
        requestAnimationFrame(positionCollapsedPanel);
        // Then re-position when the actual video
        // dimensions are known (loadedmetadata fires).
        // The { once: true } ensures the listener fires
        // at most once per video element.
        currentEl.addEventListener('loadedmetadata', function() {
          // Wait for one more frame so the browser
          // has had time to resize the video element.
          requestAnimationFrame(positionCollapsedPanel);
        }, { once: true });
        // Fallback: if loadedmetadata never fires
        // within 3 seconds, the initial poster-sized
        // position remains (better than the CSS
        // fallback on the left).
      } else {
        requestAnimationFrame(positionCollapsedPanel);
      }
    }
  }
  // Per user request 2026-07-02: when the panel is
  // collapsed (vertical bar), position it just to
  // the LEFT of the image, vertically centered with
  // the image. This makes the panel feel attached
  // to the image rather than floating at the edge
  // of the lightbox.
  //
  // Implementation: measure the image's position in
  // viewport coordinates, compute the panel's left
  // position (= image.left - panel.width - gap) and
  // top (= image.verticalCenter - panel.height / 2),
  // then set inline styles on the panel. The panel's
  // CSS already sets position: absolute, so the values
  // are relative to the overlay (which is position:
  // fixed, so effectively the viewport).
  //
  // The inline styles override the .collapsed CSS
  // rule's left: 0.5rem and top: 50% positions. We
  // only position the panel if it's collapsed — for
  // the expanded state, the panel sits at the bottom
  // of the lightbox as before (no JS positioning
  // needed; the CSS handles it).
  //
  // This function is defined in the outer IIFE scope
  // (not inside show()) so that the panel toggle
  // handlers (also in the outer scope) can call it
  // when the user clicks the header to collapse.
  function positionCollapsedPanel() {
    if (!currentEl) return;
    var imgRect = currentEl.getBoundingClientRect();
    // Determine which panel to position (only the
    // visible one — if EXIF is hidden because the file
    // has no metadata, we don't position it).
    var panel = null;
    if (currentEl.tagName === 'VIDEO') {
      panel = overlay.querySelector('.lb-video-meta');
      if (panel && panel.hidden) panel = null;
    } else {
      panel = overlay.querySelector('.lb-exif');
      if (panel && panel.hidden) panel = null;
    }
    if (!panel || !panel.classList.contains('collapsed')) return;
    var panelRect = panel.getBoundingClientRect();
    // Per user request 2026-07-02: position the collapsed
    // panel on the RIGHT side of the image, slightly
    // OVERLAPPING the image's right edge (instead of
    // positioned to the LEFT of the image with a gap).
    // This makes the panel feel more attached to the
    // image — the bar "leans against" the right edge.
    //
    // overlap is negative (= -panelRect.width * fraction)
    // so the panel's left edge sits INSIDE the image's
    // right edge by `overlap` pixels. With overlap=8,
    // the panel's left edge is 8px inside the image.
    var overlap = 8;
    var newLeft = imgRect.right - panelRect.width + overlap;
    var newTop = imgRect.top + imgRect.height / 2 - panelRect.height / 2;
    // Edge case: if the image is so far left that the
    // panel would be offscreen, fall back to left: 0.5rem.
    if (newLeft < 0) newLeft = 8;
    panel.style.left = newLeft + 'px';
    panel.style.top = newTop + 'px';
    panel.style.transform = 'none';  // override the translateY(-50%) from the .collapsed rule
  }

  function close() {
    overlay.classList.remove('open');
    clear();
  }

  cards.forEach(function(c, i) {
    c.addEventListener('click', function(e) {
      // The open-btn (and its descendants) opens the file in a new
      // tab instead of the lightbox. Its own click handler calls
      // stopPropagation, but be defensive in case it doesn't.
      if (e.target.closest && e.target.closest('.open-btn')) return;
      e.preventDefault();
      show(i);
    });
  });

  // "Open in new tab" button on each tile. Clicking it (or pressing
  // Enter/Space when focused) opens the file URL in a new tab
  // instead of the lightbox. We stop propagation so the card's own
  // click handler (above) doesn't ALSO try to open the lightbox.
  document.querySelectorAll('.open-btn').forEach(function(btn) {
    var openUrl = function() {
      var url = btn.getAttribute('data-open-url');
      if (url) window.open(url, '_blank');
    };
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      openUrl();
    });
    btn.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        e.stopPropagation();
        openUrl();
      }
    });
  });

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) close();
  });
  overlay.querySelector('.lb-close').addEventListener('click', close);
  // Per Phase 65: the prev/next hit areas are now 100vh tall x
  // 120px wide. They sit ON TOP of the media (z-index: 1). When
  // the user clicks inside the prev/next area, the button's click
  // fires (which advances/retreats by 1) AND the event bubbles to
  // media, which would ALSO advance (its click handler runs
  // show(idx+1) for <img>). Without stopPropagation here, clicking
  // "Next" would advance by 2 instead of 1.
  overlay.querySelector('.lb-prev').addEventListener('click', function(e) {
    e.stopPropagation();
    show(idx - 1);
  });
  overlay.querySelector('.lb-next').addEventListener('click', function(e) {
    e.stopPropagation();
    show(idx + 1);
  });
  // Open-in-new-tab: opens the current image/video URL in a new
  // tab. Uses cards[idx].href (the same href that show() set on
  // currentEl). window.open with _blank is the standard way; the
  // noopener/noreferrer flags prevent the new tab from accessing
  // window.opener (security best practice).
  overlay.querySelector('.lb-open').addEventListener('click', function() {
    if (cards.length === 0) return;
    var href = cards[idx].getAttribute('href') || '';
    if (href) window.open(href, '_blank', 'noopener,noreferrer');
  });
  // Click on the media area advances to the next item. EXCEPT
  // when the current media is a <video>: on mobile, tapping the
  // video's native play button fires a click event on the
  // <video> element, and the default click handler advances to
  // the next file BEFORE the video can play (a really bad UX --
  // the user taps play, expects the video to start, and instead
  // sees the next image). Detect this case and bail out so the
  // browser's native click handling (play / pause) takes over.
  // The user can still navigate via the prev/next buttons or
  // the arrow keys.
  media.addEventListener('click', function(e) {
    if (currentEl && currentEl.tagName === 'VIDEO') return;
    e.stopPropagation();
    show(idx + 1);
  });
  document.addEventListener('keydown', function(e) {
    if (!overlay.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(idx - 1);
    else if (e.key === 'ArrowRight') show(idx + 1);
  });

    /* === SECTION TOGGLE (Phase 71, extended in Phase 74) =========
       The directories + other-files sections each have a toggle
       behavior: clicking the section heading (the whole width)
       collapses the body (display: none) and updates the
       button's text + aria. The state is persisted in localStorage
       so the visitor's choice survives navigations and refreshes.

       Per user request 2026-06-19: the WHOLE WIDTH of the section
       heading is now clickable, not just the small − / + button.
       The button is still rendered (and is still keyboard-tabbable
       + screen-reader-announceable) as a visual affordance +
       a11y target, but the user can click anywhere on the
       heading row to toggle.

       Why localStorage (not URL query / not page state):
         - URL query would be bookmarkable, but the toggle is a
           personal preference, not a content filter
         - Page state would reset on every refresh
         - localStorage = persistent + per-visitor, which is the
           right scope for "show/hide the dirs section"

       The button is rendered as the minus sign when expanded and
       the plus sign when collapsed -- Unicode characters that
       are commonly understood as collapse/expand affordances.
       (Phase 71 note: this used to be line comments with //,
       but Go html/template strips // from script blocks during
       parsing. Block comments survive, and JS supports both
       styles the same way.) */
    (function() {
      var STORAGE_PREFIX = 'gallery-section-';
      function toggleSection(section) {
        var sectionEl = document.querySelector('[data-section="' + section + '"]');
        if (!sectionEl) return;
        var btn = sectionEl.querySelector('.section-toggle');
        var key = STORAGE_PREFIX + section;
        var isCollapsed = sectionEl.classList.toggle('collapsed');
        if (btn) {
          btn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
          btn.textContent = isCollapsed ? '+' : '−';
        }
        try {
          if (isCollapsed) {
            localStorage.setItem(key, 'collapsed');
          } else {
            localStorage.removeItem(key);
          }
        } catch (e) {
          // Ignore localStorage write errors (private mode, etc.)
        }
      }
      // Find all section headings (the toggle target is the
      // whole <h2> row, not just the small button). We also keep
      // the click handler on the button for accessibility —
      // keyboard users tab to the button and press Enter, screen
      // readers announce "Show/hide directories" via the
      // button's title + aria-label.
      // Per Phase 113: added .media-section to the selector
      // list so the Media section's toggle button works (it
      // was previously excluded, making the toggle a no-op).
      var headings = document.querySelectorAll('.dirs-section .section-heading, .others-section .section-heading, .media-section .section-heading');
      headings.forEach(function(h) {
        var section = h.parentElement.getAttribute('data-section');
        if (!section) return;
        // Apply persisted state on load.
        var key = STORAGE_PREFIX + section;
        try {
          if (localStorage.getItem(key) === 'collapsed') {
            h.parentElement.classList.add('collapsed');
            var btn = h.querySelector('.section-toggle');
            if (btn) {
              btn.setAttribute('aria-expanded', 'false');
              btn.textContent = '+';
            }
          }
        } catch (e) {
          // localStorage can be disabled (private mode, etc.).
          // Fail silently — the toggle just won't persist.
        }
        // Toggle on click of the heading (whole row).
        h.addEventListener('click', function() {
          toggleSection(section);
        });
        // Also keep the click handler on the button — it calls
        // stopPropagation so the heading handler doesn't run
        // twice (once for the button, once for the heading).
        var btn = h.querySelector('.section-toggle');
        if (btn) {
          btn.addEventListener('click', function(e) {
            e.stopPropagation();
            toggleSection(section);
          });
        }
      });
    })();

    // === THEME TOGGLE ========================================
    // 3 states: auto (default, follows OS), light, dark.
    // The choice persists in localStorage so the visitor doesn't
    // have to re-pick on every visit. The data-theme attribute
    // is set on <html> so CSS can target it.
    (function() {
      var STORAGE_KEY = 'gallery-theme';
      var toggle = document.querySelector('.theme-toggle');
      if (!toggle) return;

      function currentTheme() {
        var attr = document.documentElement.getAttribute('data-theme');
        if (attr === 'light' || attr === 'dark') return attr;
        return 'auto';
      }

      function applyTheme(theme) {
        if (theme === 'auto') {
          document.documentElement.removeAttribute('data-theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
        }
        updateButtons();
      }

      function updateButtons() {
        var current = currentTheme();
        var buttons = toggle.querySelectorAll('button[data-theme]');
        for (var i = 0; i < buttons.length; i++) {
          var btn = buttons[i];
          var isActive = btn.dataset.theme === current;
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }
      }

      // Apply saved preference (or remove data-theme for 'auto')
      try {
        var saved = localStorage.getItem(STORAGE_KEY);
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      } catch (e) { /* localStorage unavailable */ }
      updateButtons();

      // Click handler
      toggle.addEventListener('click', function(e) {
        var btn = e.target.closest('button[data-theme]');
        if (!btn) return;
        var theme = btn.dataset.theme;
        applyTheme(theme);
        try { localStorage.setItem(STORAGE_KEY, theme); } catch (e) {}
      });
    })();

    })();

/* Per user request 2026-07-01: "Back To Top" button
   behavior. The button is fixed at the bottom-center of
   the viewport and is hidden by default (opacity: 0,
   pointer-events: none). The scroll listener toggles the
   .visible class when the user has scrolled past one
   full viewport height (i.e. they've scrolled at least
   one screen of content). The click handler scrolls to
   the top of the page using window.scrollTo with
   behavior: 'smooth' (CSS scroll-behavior would be
   equivalent, but the JS approach is more explicit and
   works in older browsers).

   Per user request 2026-07-02: the button now also
   displays the scroll percentage (e.g. "23%") as a
   small badge. The percentage is computed as
   scrollY / (scrollHeight - clientHeight) * 100,
   giving 0% at the top and 100% at the bottom.
   Edge cases:
   - If scrollHeight === clientHeight (page is shorter
     than the viewport), the page can't be scrolled, so
     the percentage is 0 (or 100 — both are fine).
   - requestAnimationFrame is used to throttle the DOM
     write to the next frame, so the scroll handler
     stays cheap even for fast scrolls.
   - The percentage is clamped to [0, 100] so the badge
     never shows negative or >100 values (e.g. if the
     user scrolls past the end with momentum). */
(function() {
  var btn = document.getElementById('back-to-top');
  if (!btn) return;
  var pctEl = btn.querySelector('.back-to-top-pct');
  // Threshold: one full viewport height. The button
  // appears after the user has scrolled at least one
  // screen's worth of content (per user spec).
  var threshold = window.innerHeight;
  var rafId = 0;
  function update() {
    rafId = 0;
    if (window.scrollY > threshold) {
      btn.classList.add('visible');
    } else {
      btn.classList.remove('visible');
    }
    // Compute and display the scroll percentage
    var scrollable = document.documentElement.scrollHeight - window.innerHeight;
    var pct = scrollable > 0
      ? Math.round((window.scrollY / scrollable) * 100)
      : 0;
    // Clamp to [0, 100]
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    if (pctEl) pctEl.textContent = pct + '%';
  }
  function scheduleUpdate() {
    if (rafId) return;
    rafId = requestAnimationFrame(update);
  }
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  // Also update on resize (the threshold changes if the
  // viewport height changes — e.g. user resizes browser,
  // or rotates a tablet).
  window.addEventListener('resize', scheduleUpdate);
  // Initial state (in case the page loads scrolled).
  scheduleUpdate();
  // Click handler: smooth scroll to top.
  btn.addEventListener('click', function(e) {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>
</body>
</html>