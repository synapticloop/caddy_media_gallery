      // leave the rest alone. When they differ, the JS has
      // taken over and we recompute the N value + annotation
      // based on whether the page is paginated.
      var urlQuery = getSearchParam();
      var isServerRendered = (currentQuery === urlQuery);
      if (isServerRendered) {
        // Server-rendered state. Restore the server's
        // original text (e.g. "Media (89 - search 'st'
        // - showing 30 of 33)" for pageSize=30, total=33).
        // This handles the case where the visitor typed
        // more chars (JS took over, text changed) and
        // then typed back to match the URL — the header
        // should "change back" to the server's text.
        if (originalServerText) {
          headerEl.textContent = originalServerText;
        }
        return;
      }
      // JS-typed state (input differs from URL ?q=).
      // Determine the N value and the <em>This page</em>
      // annotation based on whether the page is paginated:
      //
      // - Not paginated (FilteredTotal <= OnPageTotalCount):
      //   all matches fit on this page. N = FilteredTotal
      //   (the total), no <em>This page</em>.
      //
      //   Example: pageSize=60, total=33, user types 'str'.
      //   Result: "9 of 33" (no annotation).
      //
      // - Paginated (FilteredTotal > OnPageTotalCount):
      //   the JS is filtering within the current page only.
      //   N = OnPageTotalCount, with "<em>This page</em>".
